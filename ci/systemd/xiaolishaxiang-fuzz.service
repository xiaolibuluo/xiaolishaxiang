# xiaolishaxiang 长程 fuzz 定时流水线服务单元（docs/04-TEST-MATRIX.md 第 3 级 Scheduled）。
# 安装：cp ci/systemd/xiaolishaxiang-fuzz.service /etc/systemd/system/
#       cp ci/systemd/xiaolishaxiang-fuzz.timer /etc/systemd/system/
#       systemctl daemon-reload && systemctl enable --now xiaolishaxiang-fuzz.timer
[Unit]
Description=xiaolishaxiang long-duration fuzz test (Scheduled, daily)
Documentation=file:/root/xiaolishaxiang/docs/04-TEST-MATRIX.md
[Service]
Type=oneshot
WorkingDirectory=/root/xiaolishaxiang
Environment=XS_FUZZ_DURATION_SECS=3600
Environment=PATH=/root/.cargo/bin:/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/root/xiaolishaxiang/ci/run_fuzz_smoke.sh
# 1h fuzz + 构建余量；超时即失败（Scheduled 阻断发布语义）
TimeoutStartSec=5400
# 产物由脚本自行落在 artifacts/fuzz/，日志进 journal（journalctl -u ...）
StandardOutput=journal
StandardError=journal
SyslogIdentifier=xiaolishaxiang-fuzz
